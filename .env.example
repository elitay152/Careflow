# Local development only. Choose a password, then copy this file to .env.
POSTGRES_PASSWORD=replace-with-a-local-password
# URL-encode special characters when constructing DATABASE_URL.
DATABASE_URL=postgresql+psycopg://careflow:replace-with-a-local-password@localhost:5432/careflow
# scripts/configure_assistant.py adds a generated CAREFLOW_ASSISTANT_DATABASE_URL.
# CAREFLOW_ASSISTANT_MODE defaults to baseline. Set to llm to use the model planner.
# Inject CAREFLOW_LLM_API_KEY securely in environment settings; don't commit it.
# CAREFLOW_LLM_MODEL defaults to gpt-4.1-mini.
# Live limits default to 5 attempts/UTC day and 25 over this workspace ledger's lifetime.
# Optional lower caps: CAREFLOW_LLM_DAILY_REQUEST_LIMIT=1 and CAREFLOW_LLM_LIFETIME_REQUEST_LIMIT=5.
# Preserve data/llm-usage.sqlite3 across restarts; do not commit it.
